rules_version = '2';

// ============================================================
// REGLAS DE SEGURIDAD — Panadería Del Horno
// ------------------------------------------------------------
// Cómo instalarlas:
//   Firebase Console → Firestore Database → Reglas → pega este
//   contenido → Publicar.
//
// Lógica de permisos:
//   - Debe existir un documento en /usuarios/{uid} con el UID
//     del usuario autenticado.
//   - rol == "administrador"  -> lectura y escritura completas.
//   - rol == "socio"          -> solo lectura en todo el sistema.
//   - sin documento de perfil -> sin acceso.
//
// IMPORTANTE: esta es la única fuente real de la restricción de
// "solo lectura" del socio — la interfaz oculta botones por
// comodidad, pero quien realmente lo impide es esta regla.
// ============================================================

function isSignedIn() {
  return request.auth != null;
}

function perfil() {
  return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
}

function esAdmin() {
  return isSignedIn()
    && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
    && perfil().rol == "administrador";
}

function tieneAcceso() {
  return isSignedIn()
    && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfiles de usuario: cualquiera con sesión puede leer los perfiles
    // (para mostrar nombres), pero solo el administrador puede escribirlos.
    match /usuarios/{uid} {
      allow read: if isSignedIn();
      allow write: if esAdmin();
    }

    // Todas las demás colecciones del sistema:
    // rutas, productos, jornadas, inventarioMovimientos, ventas,
    // gastos, categoriasGasto, vehiculos, combustible,
    // mantenimientos, depositos.
    match /{coleccion}/{docId} {
      allow read: if tieneAcceso();
      allow write: if esAdmin();
    }
  }
}
